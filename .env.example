# Credenziali Supabase del progetto.
# Copia questo file in .env e riempi i valori (Supabase > Project Settings > API).
# Sono variabili build-time: Vite le compila dentro il bundle, quindi vanno
# configurate anche nelle Environment Variables del progetto su Vercel.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
